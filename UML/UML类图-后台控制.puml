@startuml UML类图-后台控制
!define PLANTUML_LIMIT_SIZE 16384
top to bottom direction

' 数据统计相关类
class DataStatistics {
  + cycle: String
  + dimension: String
  + value: Double
  + category: String
  + exportExcel(): File
  + generateChart(): Image
  + getTrendData(): List(DataStatistics)
}

class UserDataService {
  + getUserActivityStats(userId: String): DataStatistics
  + getSalesData(userId: String, period: String): DataStatistics
  + getPurchaseData(userId: String, period: String): DataStatistics
  + getReturnRate(userId: String, period: String): DataStatistics
  + getHotRanking(period: String): List(Commodity)
  + exportUserReport(userId: String): File
}

class PlatformDataService {
  + crudBasicData(type: String, data: Map): Boolean
  + getPlatformSales(period: String): List(DataStatistics)
  + getCategorySales(category: String, period: String): DataStatistics
  + generatePlatformChart(): Image
  + getPlatformTrends(): List(DataStatistics)
}

' 用户管理相关类
class UserVipService {
  + calcActivity(userId: String): DataStatistics
  + divideVipLevel(userId: String): String
  + bindVipRights(vipLevel: String, rights: List(String)): Boolean
  + updateUserLevel(userId: String): Boolean
  + getVipUsers(level: String): List(User)
}

class UserActivityRecord {
  + recordId: String
  + userId: String
  + activityType: String
  + activityTime: Date
  + activityData: Map
  + recordActivity(): Boolean
}

' 商品审核相关类
class CommodityAuditService {
  + autoAudit(commodity: Commodity): Boolean
  + flagForManualReview(commodityId: String): Boolean
  + manualReview(commodityId: String): Boolean
  + batchAudit(commodityIds: List(String)): Boolean
  + getAuditQueue(): List(Commodity)
}

class AuditRecord {
  + recordId: String
  + commodityId: String
  + reviewerId: String
  + reason: String
  + decision: String
  + auditTime: Date
  + createRecord(): Boolean
}

' 违规处理相关类
class ViolationHandleService {
  + banByRealName(realNameId: String): Boolean
  + banByDevice(deviceCode: String): Boolean
  + banByPhone(phone: String): Boolean
  + restrictUserFunctions(userId: String): Boolean
  + checkViolation(userId: String): Boolean
  + liftBan(userId: String): Boolean
}

class BanRecord {
  + banId: String
  + userId: String
  + phone: String
  + deviceId: String
  + realNameId: String
  + reason: String
  + startAt: Date
  + endAt: Date
  + banType: String
  + createBan(): Boolean
}

' 营销工具相关类
class PromotionTool {
  + createCoupon(type: String, rule: Map): Boolean
  + setFullReduce(rule: Map): Boolean
  + setLimitedDiscount(commodityId: String, rate: Double, time: Int): Boolean
  + getUserPromotions(userId: String): List(Promotion)
  + validatePromotion(promotionId: String): Boolean
}

class Promotion {
  + promotionId: String
  + userId: String
  + type: String
  + rules: Map
  + startTime: Date
  + endTime: Date
  + status: String
  + createPromotion(): Boolean
  + activatePromotion(): Boolean
}

' 权限管理相关类（简化版，不包含子账号）
class UserPermissionService {
  + setUserPermissions(userId: String, permissions: List(String)): Boolean
  + getUserPermissions(userId: String): List(String)
  + checkPermission(userId: String, permission: String): Boolean
  + updateRolePermissions(role: String, permissions: List(String)): Boolean
}

class PermissionTemplate {
  + templateId: String
  + name: String
  + permissions: List(String)
  + description: String
  + applyTemplate(userId: String): Boolean
}

' 关系定义
UserDataService ..> DataStatistics : generates
PlatformDataService ..> DataStatistics : manages
UserVipService ..> UserActivityRecord : tracks
CommodityAuditService ..> AuditRecord : creates
ViolationHandleService ..> BanRecord : manages
PromotionTool ..> Promotion : creates
UserPermissionService ..> PermissionTemplate : uses


@enduml