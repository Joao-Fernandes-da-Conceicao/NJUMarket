@startuml UML活动图
start
:开始使用系统;
if (是否需要注册/登录?) then (是)
  if (选择登录方式?) then (手机号)
    :输入手机号;
    :获取验证码;
    :输入验证码;
  else if (QQ)
    :跳转QQ授权登录;
  else if (微信)
    :跳转微信授权登录;
  else (Apple账号)
    :跳转Apple授权登录;
  endif
  :验证登录信息;
else (否)
  :跳过登录（仅浏览）;
endif

if (是否使用搜索功能?) then (是)
  :输入搜索关键词;
  :AI语义理解分析;
  :按"距离+相关性"排序;
  if (需要价格筛选?) then (是)
    :设置价格区间;
    :筛选结果;
  else (否)
    :直接展示排序结果;
  endif
else (否)
  :浏览系统推荐内容;
endif

if (是否进行交易?) then (是)
  :选择商品/服务;
  :进入订单流程;
  :确认订单信息;
  :支付订单;
  if (是否退货?) then (是)
    :发起退货申请;
    :平台审核退货;
    :处理退货流程;
  else (否)
    :完成交易;
  endif
else (否)
  :仅浏览，不交易;
endif

if (是否有投诉需求?) then (是)
  :进入投诉入口;
  :填写投诉内容;
  :上传投诉凭证;
  :提交投诉;
  :查看投诉处理进度;
else (否)
  :无投诉需求;
endif

if (用户功能管理?) then (是)
  if (商品管理?) then (是)
    :发布/编辑商品;
    :批量上下架商品;
    :批量修改库存;
    :商品分组管理;
  else (否)
    :不进行商品管理;
  endif
  if (订单管理?) then (是)
    :查看订单详情;
    :处理不同状态订单;
    :批量发货;
    :导出订单数据;
  else (否)
    :不进行订单管理;
  endif
  if (数据统计?) then (是)
    :查看多维度经营数据;
    :导出统计报表;
  else (否)
    :不进行数据统计;
  endif
  if (营销工具?) then (是)
    :创建优惠券;
    :设置满减活动;
    :发起限时折扣;
  else (否)
    :不使用营销工具;
  endif
else (否)
  :不进行功能管理;
endif

if (平台后台管理?) then (是)
  if (基础数据管理?) then (是)
    :增删改查基础数据;
    :查看板块成交数据;
    :生成对比图表;
  else (否)
    :不进行基础数据管理;
  endif
  if (用户管理?) then (是)
    :统计用户活跃度;
    :划分VIP等级;
    :关联VIP权益;
  else (否)
    :不进行用户管理;
  endif
  if (商品审核?) then (是)
    :智能审核商品;
    :人工复审异常商品;
  else (否)
    :不进行商品审核;
  endif
  if (违规处理?) then (是)
    :封禁恶意用户;
    :限制系统功能使用;
  else (否)
    :不进行违规处理;
  endif
else (否)
  :非平台后台管理操作;
endif

if (是否切换UI皮肤?) then (是)
  :选择皮肤（NJU紫/小蓝鲸等）;
else (否)
  :使用默认皮肤;
endif

if (是否切换深浅色模式?) then (是)
  :根据环境光自动切换;
else (否)
  :使用当前模式;
endif

stop


@enduml