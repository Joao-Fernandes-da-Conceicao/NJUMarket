@startuml UML组件图
' 统一的用户端模块（买卖同端同账号）
node "用户端模块（买卖统一）" {
  component "UserLoginService" as ULS
  component "AISearchService" as AISS
  component "UserCommunicationService" as UCS
  component "UserOrderService" as UOS
  component "UserComplaintService" as UCS2
  component "CommodityManagementService" as CMS
  component "UserDataService" as UDS
  component "PromotionTool" as PT
  component "UserPermissionService" as UPS
  component "UIIndicator" as UII
}

node "平台后台管理模块" {
  component "PlatformDataService" as PDS
  component "UserVipService" as UVS
  component "CommodityAuditService" as CAS
  component "ViolationHandleService" as VHS
}

node "公共基础模块" {
  component "User" as U
  component "UserProfile" as UP
  component "Commodity" as C
  component "Order" as O
  component "Message" as M
  component "ContactInfo" as CI
  component "Complaint" as CP
  component "DataStatistics" as DS
  component "UserActivityRecord" as UAR
  component "AuditRecord" as AR
  component "BanRecord" as BR
  component "Promotion" as P
  component "PermissionTemplate" as PT2
}

' 外部应用与用户
node "外部应用与用户" {
  component "用户（买家/卖家统一）" as UserExt
  component "手机应用" as MobileApp
  component "第三方登录服务" as ThirdPartyAuth
}

' 用户端模块内部依赖关系
ULS --> U : 管理用户登录
AISS --> C : 搜索商品
UCS --> M : 处理消息
UCS --> CI : 管理联系方式
UOS --> O : 处理订单
UCS2 --> CP : 处理投诉
CMS --> C : 管理商品
UDS --> DS : 生成统计数据
PT --> P : 创建促销活动
UPS --> PT2 : 使用权限模板
UII --> U : 配置用户界面

' 平台管理模块依赖关系
PDS --> DS : 管理平台数据
UVS --> UAR : 跟踪用户活动
CAS --> AR : 记录审核信息
VHS --> BR : 管理封禁记录

' 用户与模块交互
UserExt --> ULS : 登录注册
UserExt --> AISS : 搜索商品
UserExt --> UCS : 站内沟通
UserExt --> UOS : 订单管理
UserExt --> UCS2 : 投诉处理
UserExt --> CMS : 商品管理
UserExt --> UDS : 数据查看
UserExt --> PT : 营销工具
UserExt --> UPS : 权限设置
UserExt --> UII : 界面设置

' 外部集成
MobileApp --> U : 集成用户功能
ThirdPartyAuth --> ULS : 第三方登录


@enduml