# ========== 与 njumarket-service-ai / njumarket-service-ai-dev.yml 对齐 ==========

# 服务端口：Python AI Agent 独立端口，区别于 Java njumarket-service-ai（8098），网关路由至此
SERVER_PORT=8099
HOST=0.0.0.0

# PostgreSQL（与 application.yml spring.datasource）
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/njumarket?currentSchema=nju_market
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-postgres-password

# Redis（AI_REDIS_DATABASE:3）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=hqz20050316
AI_REDIS_DATABASE=3

# Milvus（njumarket.ai.milvus）
MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COMMODITY_COLLECTION=commodity_vectors
MILVUS_USER_PROFILE_COLLECTION=user_profile_vectors
MILVUS_CONVERSATION_COLLECTION=conversation_memory_vectors
MILVUS_DIMENSION=1024
MILVUS_TOP_K=10
# 与 Java MilvusVectorService.VECTOR_FIELD 一致（集合里向量列名）
MILVUS_VECTOR_FIELD=embedding
MILVUS_METRIC_TYPE=COSINE
MILVUS_MEMORY_TOP_K=12

# 豆包 / ARK OpenAI 兼容接口
# DOUBAO_API_KEY: ARK 控制台 "API Key 管理" 页面，点击对应 Key 的 "查看" 复制到的那串 Value
#                 格式示例：3f0e...（非 UUID，非 Resource ID，是创建时一次性显示的 secret）
# DOUBAO_CHAT_MODEL: 使用 "预置模型" 时填模型名（如 doubao-pro-32k）；
#                    使用 "推理接入点" 时填接入点 ID（UUID 格式，如 8736b46e-...）
DOUBAO_API_KEY=your-ark-api-key-value
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=doubao-seed-1-6-250615
DOUBAO_EMBEDDING_MODEL=doubao-embedding-text-240715

# 交易服务（Feign njumarket-service-trade 本机端口 8092）
COMMODITY_BASE_URL=http://localhost:8092
